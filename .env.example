# Opción 1: Postgres administrado por URL (usa SSL por defecto)
DATABASE_URL=
# Opcional: require (por defecto), disable, prefer...
DATABASE_SSLMODE=

SENDGRID_API_KEY=
FROM_MAIL=
SECRET_KEY=

# Opción 2: Postgres local (docker-compose). Se usa cuando DATABASE_URL está vacío.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=
